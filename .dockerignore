# Secrets: the API key must never be baked into an image layer
.env
# Template for humans; the app doesn't read it at run time
.env.example

# Local environment: the Windows venv is useless (and huge) inside a Linux container
.venv/
env/
venv/
venv_*/

# Python bytecode caches
__pycache__/
*.pyc

# Local data: the database lives in a volume, not in the image
expense.db

# Version control and editor/tool folders
.git/
.gitignore
.idea/
.vscode/
.claude/

# Dev scratch files and build files the app doesn't need at run time
scratch.py
Dockerfile
.dockerignore
